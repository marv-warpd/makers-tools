# Secrets and addresses. Copy to tools-server/.dev.vars to work on the tools server locally (README, "Deploy").
# The deployed Workers do not read this file: their secrets are set with `npx wrangler secret put` (README, "Deploy").
# Never commit a filled copy.

# A ClickUp personal API key from an admin seat. Both Workers read and write as that seat.
CLICKUP_TOKEN=

# The key ClickUp sends with each call to the tools server. Make one with: openssl rand -hex 32
MCP_API_KEY=

# The secret the three webhooks send in the X-Webhook-Secret header. Make one with: openssl rand -hex 32
WEBHOOK_SECRET=

# The two Workers' addresses, as Wrangler prints them on deploy.
MAKERS_TOOLS_URL=https://makers-tools.<your-subdomain>.workers.dev/mcp
EVENT_SERVICE_URL=https://makers-approval.<your-subdomain>.workers.dev
